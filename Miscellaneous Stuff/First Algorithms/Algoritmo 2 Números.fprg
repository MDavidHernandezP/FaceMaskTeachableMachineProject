    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Primero" type="Integer" array="False" size=""/>
            <declare name="Segundo" type="Integer" array="False" size=""/>
            <declare name="Tercero" type="Integer" array="False" size=""/>
            <declare name="Cuarto" type="Integer" array="False" size=""/>
            <declare name="Quinto" type="Integer" array="False" size=""/>
            <declare name="Sexto" type="Integer" array="False" size=""/>
            <declare name="S&#233;ptimo" type="Integer" array="False" size=""/>
            <declare name="Octavo" type="Integer" array="False" size=""/>
            <assign variable="Primero" expression="1"/>
            <assign variable="Segundo" expression="1"/>
            <assign variable="Tercero" expression="Primero+Segundo"/>
            <assign variable="Cuarto" expression="Segundo+Tercero"/>
            <assign variable="Quinto" expression="Tercero+Cuarto"/>
            <assign variable="Sexto" expression="Cuarto+Quinto"/>
            <assign variable="S&#233;ptimo" expression="Quinto+Sexto"/>
            <assign variable="Octavo" expression="Sexto+S&#233;ptimo"/>
            <output expression="&quot;Escribe el T&#233;rmino que quieras ver&quot;" newline="True"/>
            <output expression="Primero" newline="True"/>
        </body>
